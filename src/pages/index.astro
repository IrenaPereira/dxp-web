---
import Base from "../layouts/Base.astro";

const services = [
  {
    title: "Tactical UI/UX",
    body: "Prototyping, wireframing/greyboxing, UX & UI design, UI animation, and implementation. We integrate into your team fast and turn around working Figma files in days.",
  },
  {
    title: "Strategic UX",
    body: "Game brand design, UI art direction, vision clarification, product/market fit, persona development, and design systems — the senior-level thinking that sets direction.",
  },
  {
    title: "UX for Teams",
    body: "Lean UCD training, maturing UX practices, psychological safety, collaboration workshops, process and service design. We help teams build the way they ship.",
  },
];

const work = [
  {
    client: "Mythical Games — Blankos Block Party",
    kind: "Tactical UX & UI",
    body: "Integrated within 24 hours of first contact to ship special features on a crunch-worthy timeline — redesigning skill and inventory access plus event onboarding.",
  },
  {
    client: "Epic Spell Wars",
    kind: "Combat Design & Prototyping",
    body: "Concepted and prototyped core combat gameplay and an intuitive deck-building experience to turn a famous card game into a web3 video game.",
  },
  {
    client: "A new Monopoly title",
    kind: "UI Art Direction",
    body: "Deep user research led to a clearer, more appropriate expression of Monopoly for a newly defined target audience — fixing a hard-to-read UI.",
  },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">UX/UI design studio for video games</p>
      <h1>better design,<br /><span>better games.</span></h1>
      <p class="lede">
        Digital Experiments is a third-party design studio for video game
        studios. A veteran team with 20+ years of games UX — from tactical
        UI/UX execution to senior strategic vision.
      </p>
      <div class="actions">
        <a href="/work" class="btn">See our work</a>
        <a href="mailto:sayhi@digitalexperiments.com" class="btn btn-ghost">Start a project</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2 class="section-title">Design services, end to end</h2>
      <div class="grid">
        {services.map((s) => (
          <article class="card">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="section section-alt">
    <div class="container">
      <p class="eyebrow">Work highlights</p>
      <h2 class="section-title">Trusted by studios shipping real games</h2>
      <div class="grid">
        {work.map((w) => (
          <article class="card">
            <p class="kind">{w.kind}</p>
            <h3>{w.client}</h3>
            <p>{w.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container about">
      <p class="eyebrow">About</p>
      <h2 class="section-title">Start with the problem. Then sprinkle in delight.</h2>
      <p class="lede">
        We're a senior, distributed team of game UX specialists. We solve the
        problems that matter first, then layer in the craft that makes a game
        feel great — and we leave your team stronger than we found it.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 8rem);
    background:
      radial-gradient(60% 80% at 80% -10%, rgba(124, 92, 255, 0.22), transparent 70%),
      radial-gradient(50% 60% at 0% 10%, rgba(0, 224, 198, 0.12), transparent 70%);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 8vw, 5rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }
  .hero h1 span { color: var(--accent); }
  .lede {
    max-width: 640px;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-muted);
  }
  .actions { display: flex; gap: 1rem; margin-top: 2.25rem; flex-wrap: wrap; }

  .section-alt { background: var(--bg-elev); }
  .section-title { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: 2.5rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .card h3 { font-size: 1.3rem; }
  .card p { color: var(--text-muted); margin: 0; }
  .card .kind {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    color: var(--accent-2);
    margin-bottom: 0.5rem;
  }
  .about { max-width: 760px; }
</style>
