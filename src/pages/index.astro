---
import Base from "../layouts/Base.astro";

const services = [
  {
    n: "01",
    title: "Embedded UX & UI",
    body: "Your senior hands this sprint. Prototyping, wireframing/greyboxing, UX & UI design, animation, and implementation — embedded in your team within 24 hours, working Figma files in days.",
  },
  {
    n: "02",
    title: "UX Strategy",
    body: "Clarity before execution: game brand design, UI art direction, vision clarification, product/market fit, personas, and design systems — the senior thinking that sets direction.",
  },
  {
    n: "03",
    title: "Team Workshops & Training",
    body: "We level up the team you already have. UX process, research methods, and collaboration workshops taught by people who've shipped the work — your team leaves stronger.",
  },
  {
    n: "04",
    title: "UI/UX Audits",
    body: "A senior teardown of your existing game or build. We find what your players are already saying in Discord — onboarding, moment-to-moment play, readability, accessibility — and deliver prioritized fixes your team can act on immediately.",
  },
];

const work = [
  {
    client: "Mythical Games — Blankos Block Party",
    kind: "Embedded UX & UI",
    body: "Crunch-timeline features and no UX bandwidth to spare. We embedded within 24 hours and shipped working Figma files in days — skills, inventory, and event onboarding, redesigned inside their sprint cadence.",
  },
  {
    client: "Chief Puzzle Officer",
    kind: "Battle Screen Design",
    body: "Corporate espionage with anime wackiness — a real-time card-builder with multiplayer. We brought AAA know-how to an indie mobile title, evolving a dense battle screen into something legible and fun.",
  },
  {
    client: "World of Warcraft",
    kind: "Inscription Interface",
    body: "An entirely new system for an established world. We took Inscription from a rough design doc to a shipped, fully-animated interface — a summoning-circle motif of glyphs, slots, and glowing geometry that felt native to WoW without confusing veteran players.",
  },
  {
    client: "Project Copernicus",
    kind: "Fast Travel & Systems",
    body: "38 Studios' ambitious open-world MMO. We designed the 'Mana Streamers' fast-travel system and a crafting prototype the engineers could build against — systems thinking that outlived the studio.",
  },
];

const stats = [
  { value: "20+", label: "years of games UX" },
  { value: "24h", label: "from first ping to embedded" },
  { value: "AAA→indie", label: "studios shipped with" },
  { value: "100%", label: "remote, senior team" },
];

const clients = [
  { src: "/logos/blizzard.png", name: "Blizzard Entertainment" },
  { src: "/logos/sony.png", name: "Sony" },
  { src: "/logos/warnerbros.png", name: "Warner Bros." },
  { src: "/logos/mythical.png", name: "Mythical Games" },
  { src: "/logos/38studios.png", name: "38 Studios" },
  { src: "/logos/thirdkindgames.png", name: "Third Kind Games" },
  { src: "/logos/experian.png", name: "Experian" },
  { src: "/logos/realtorcom.png", name: "REALTOR.com" },
  { src: "/logos/babydelight.png", name: "Baby Delight" },
];

const ticker = [
  "Valorant",
  "World of Warcraft",
  "Monopoly Go",
  "Blankos Block Party",
  "Epic Spell Wars",
  "Jackpot Party",
  "Goldfish Slots",
  "Project Copernicus",
  "Chief Puzzle Officer",
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <img src="/brand/bunny-white.svg" alt="" aria-hidden="true" class="hero-bunny" />
    <div class="container">
      <p class="eyebrow reveal reveal-1">Game UX studio — better design, better games</p>
      <h1>
        <span class="line reveal reveal-2">senior game UX,</span>
        <span class="line flair reveal reveal-3">embedded in days.<i class="cursor" aria-hidden="true"></i></span>
      </h1>
      <p class="lede reveal reveal-3">
        Digital Experiments embeds senior game UX designers in your team
        within 24 hours — the same team that shipped UX on Valorant, World of
        Warcraft, and Monopoly Go. Working Figma files in your hands within
        the week. Less menu rage, more playtime.
      </p>
      <div class="actions reveal reveal-4">
        <a href="/work" class="btn">See our work</a>
        <a href="mailto:sayhi@digitalexperiments.com" class="btn btn-hot">Start a project</a>
      </div>
    </div>
  </section>

  <!-- Client ticker -->
  <div class="ticker" aria-label="Games we've worked on">
    <div class="ticker-track">
      {[0, 1].map(() => (
        <span aria-hidden="true">
          {ticker.map((t) => <span class="tick"><b>▸</b> {t}</span>)}
        </span>
      ))}
    </div>
  </div>

  <!-- Stats readout -->
  <section class="stats">
    <div class="container stats-grid">
      {stats.map((s) => (
        <div class="stat">
          <span class="value">{s.value}</span>
          <span class="label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Client logo wall -->
  <section class="clients" aria-label="Clients">
    <div class="container">
      <p class="eyebrow">Clients</p>
      <ul class="logo-wall">
        {clients.map((c) => (
          <li><img src={c.src} alt={c.name} title={c.name} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="container">
      <p class="eyebrow">01 — What we do</p>
      <h2 class="section-title">Four ways to <em class="flair">engage</em></h2>
      <div class="grid">
        {services.map((s) => (
          <article class="card hud">
            <p class="kind">[{s.n}]</p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="section section-alt">
    <div class="container">
      <p class="eyebrow">02 — Work highlights</p>
      <h2 class="section-title">Trusted by studios shipping <em class="flair">real games</em></h2>
      <div class="grid">
        {work.map((w) => (
          <article class="card hud">
            <p class="kind">{w.kind}</p>
            <h3>{w.client}</h3>
            <p>{w.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container about">
      <p class="eyebrow">03 — About</p>
      <h2 class="section-title">Start with the problem. Then sprinkle in <em class="flair">delight</em>.</h2>
      <p class="lede">
        We're a senior, distributed team of game UX specialists. We solve the
        problems that matter first, then layer in the craft that makes a game
        feel great — and we leave your team stronger than we found it.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 12vw, 8.5rem);
    background:
      linear-gradient(to bottom, rgba(49, 170, 183, 0.06), transparent 55%),
      repeating-linear-gradient(to right, transparent 0 79px, rgba(255, 255, 255, 0.025) 79px 80px),
      repeating-linear-gradient(to bottom, transparent 0 79px, rgba(255, 255, 255, 0.02) 79px 80px);
  }
  /* Heritage bunny, watching from the wings */
  .hero-bunny {
    position: absolute;
    right: -2%;
    bottom: -16%;
    height: 110%;
    width: auto;
    opacity: 0.06;
    pointer-events: none;
    filter: drop-shadow(0 0 40px rgba(49, 170, 183, 0.25));
  }
  .hero .container { position: relative; }
  .hero h1 {
    font-size: clamp(2.7rem, 8.5vw, 5.8rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.03;
    margin-bottom: 1.5rem;
  }
  .hero h1 .line { display: block; }
  .hero h1 .flair { color: var(--accent); padding-right: 0.08em; }
  .cursor {
    display: inline-block;
    width: 0.1em;
    height: 0.78em;
    margin-left: 0.06em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

  .lede {
    max-width: 620px;
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    color: var(--text-muted);
  }
  .actions { display: flex; gap: 1rem; margin-top: 2.25rem; flex-wrap: wrap; }

  /* Ticker */
  .ticker {
    border-block: 1px solid var(--border);
    background: var(--bg-elev);
    overflow: hidden;
    padding-block: 0.8rem;
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: scroll 36s linear infinite;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .tick { padding-inline: 1.4rem; }
  .tick b { color: var(--accent); font-weight: 500; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }

  /* Stats */
  .stats { border-bottom: 1px solid var(--border); background: var(--bg-elev); }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .stat {
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-left: 1px solid var(--border);
  }
  .stat:last-child { border-right: 1px solid var(--border); }
  .value {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    color: var(--accent);
  }
  .label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  /* Client logo wall */
  .clients { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .logo-wall {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.25rem);
  }
  .logo-wall li { display: flex; align-items: center; }
  .logo-wall img {
    height: 40px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    /* source logos are black — render as white silhouettes on the dark UI */
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 0.55;
    transition: opacity 0.18s ease;
  }
  .logo-wall img:hover { opacity: 1; }
  /* vertical lockups get more height so they don't read undersized */
  .logo-wall img[src*="38studios"],
  .logo-wall img[src*="mythical"],
  .logo-wall img[src*="thirdkindgames"],
  .logo-wall img[src*="blizzard"] { height: 60px; }

  .section-alt { background: var(--bg-elev); border-block: 1px solid var(--border); }
  .section-title { font-size: clamp(1.7rem, 4vw, 2.5rem); margin-bottom: 2.5rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (min-width: 1000px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .card { padding: 1.75rem; }
  .card h3 { font-size: 1.25rem; }
  .card p { color: var(--text-muted); margin: 0; }
  .card .kind {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.7rem;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .about { max-width: 780px; }
</style>
