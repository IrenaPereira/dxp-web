---
import Base from "../layouts/Base.astro";
import { tracks, productServices, growthServices } from "../data/services";

const work = [
  {
    client: "Mythical Games — Blankos Block Party",
    kind: "Embedded UX & UI",
    body: "Crunch-timeline features and no UX bandwidth to spare. We embedded within 24 hours and shipped working Figma files in days — skills, inventory, and event onboarding, redesigned inside their sprint cadence.",
  },
  {
    client: "Chief Puzzle Officer",
    kind: "Battle Screen Design",
    body: "Corporate espionage with anime wackiness — a real-time card-builder with multiplayer. We brought AAA know-how to an indie mobile title, evolving a dense battle screen into something legible and fun.",
  },
  {
    client: "World of Warcraft",
    kind: "Inscription Interface",
    body: "An entirely new system for an established world. We took Inscription from a rough design doc to a shipped, fully-animated interface — a summoning-circle motif of glyphs, slots, and glowing geometry that felt native to WoW without confusing veteran players.",
  },
  {
    client: "Project Copernicus",
    kind: "Fast Travel & Systems",
    body: "38 Studios' ambitious open-world MMO. We designed the 'Mana Streamers' fast-travel system and a crafting prototype the engineers could build against — systems thinking that outlived the studio.",
  },
];

// Featured project spotlight — Chief Puzzle Officer samples, front and center
const cpoShots = [
  { src: "/portfolio/cpo-gameboard.jpg", alt: "Chief Puzzle Officer — match-3 gem battle board" },
  { src: "/portfolio/cpo-turbo-mode.jpg", alt: "Chief Puzzle Officer — turbo mode" },
  { src: "/portfolio/cpo-events.jpg", alt: "Chief Puzzle Officer — live events screen" },
  { src: "/portfolio/cpo-deck-editor.jpg", alt: "Chief Puzzle Officer — deck editor" },
];

const stats = [
  { value: "25+", label: "years of building products" },
  { value: "24h", label: "from first ping to embedded" },
  { value: "AAA→indie", label: "studios shipped with" },
  { value: "100%", label: "remote, senior team" },
];

const clients = [
  { src: "/logos/blizzard.png", name: "Blizzard Entertainment" },
  { src: "/logos/sony.png", name: "Sony" },
  { src: "/logos/warnerbros.png", name: "Warner Bros." },
  { src: "/logos/mythical.png", name: "Mythical Games" },
  { src: "/logos/38studios.png", name: "38 Studios" },
  { src: "/logos/thirdkindgames.png", name: "Third Kind Games" },
  { src: "/logos/experian.png", name: "Experian" },
  { src: "/logos/realtorcom.png", name: "REALTOR.com" },
  { src: "/logos/babydelight.png", name: "Baby Delight" },
];

const ticker = [
  "Valorant",
  "World of Warcraft",
  "Monopoly Go",
  "Blankos Block Party",
  "Epic Spell Wars",
  "Jackpot Party",
  "Goldfish Slots",
  "Project Copernicus",
  "Chief Puzzle Officer",
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <img src="/brand/bunny-white.svg" alt="" aria-hidden="true" class="hero-bunny" />
    <div class="container">
      <p class="eyebrow reveal reveal-1">Build it right. Launch it loud.</p>
      <h1>
        <span class="line reveal reveal-2">Branding, GTM, &amp;</span>
        <span class="line reveal reveal-2">experience design</span>
        <span class="line flair reveal reveal-3">
          <span class="typed" aria-hidden="true">for games.</span><i class="cursor" aria-hidden="true"></i>
          <span class="sr-only">for games, groundbreaking technologies, entertainment, consumers, and products.</span>
        </span>
      </h1>
      <p class="lede reveal reveal-3">
        Digital Experiments is your distribution hack. We map your market before
        you draw your first pixel, so deep research shapes the product, not just
        the launch. We shipped UX on Valorant, World of Warcraft, and Monopoly
        Go, and built REALTOR.com and Hollywood Stock Exchange. Now we embed in
        your team within days.
      </p>
      <div class="actions reveal reveal-4">
        <a href="/work" class="btn">See our work</a>
        <a href="#contact" class="btn btn-hot">Start a project</a>
      </div>
    </div>
  </section>

  <!-- Client ticker -->
  <div class="ticker" aria-label="Games we've worked on">
    <div class="ticker-track">
      {[0, 1].map(() => (
        <span aria-hidden="true">
          {ticker.map((t) => <span class="tick"><b>▸</b> {t}</span>)}
        </span>
      ))}
    </div>
  </div>

  <!-- Stats readout -->
  <section class="stats">
    <div class="container stats-grid">
      {stats.map((s) => (
        <div class="stat">
          <span class="value">{s.value}</span>
          <span class="label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Client logo wall -->
  <section class="clients" aria-label="Clients">
    <div class="container">
      <p class="eyebrow">Clients</p>
      <ul class="logo-wall">
        {clients.map((c) => (
          <li><img src={c.src} alt={c.name} title={c.name} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Statement band — campaign-style punchy provocation -->
  <section class="statement-band">
    <div class="container">
      <p class="eyebrow">Why it matters</p>
      <p class="statement-line">UX gets bolted on <em class="flair">way too late</em>.</p>
      <p class="statement-sub">
        So does the launch plan. We embed early — when a fix still costs a sprint, not a relaunch.
      </p>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2 class="section-title">Two tracks, one <em class="flair">senior team</em></h2>
      {[{ meta: tracks.product, items: productServices }, { meta: tracks.growth, items: growthServices }].map((g) => (
        <div class="track">
          <p class="track-label">{g.meta.label}</p>
          <div class="grid">
            {g.items.map((s) => (
              <a href="/services" class="svc">
                <span class="svc-n">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.blurb}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
      <a href="/services" class="text-link">All services →</a>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="section section-alt">
    <div class="container">
      <p class="eyebrow">02 — Work highlights</p>
      <h2 class="section-title">Trusted by studios shipping <em class="flair">real games</em></h2>
      <div class="grid">
        {work.map((w) => (
          <article class="card hud">
            <p class="kind">{w.kind}</p>
            <h3>{w.client}</h3>
            <p>{w.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured project — samples front and center -->
  <section id="featured" class="featured section">
    <div class="container featured-grid">
      <div class="featured-copy">
        <p class="eyebrow">From the portfolio</p>
        <h2 class="featured-title">Chief Puzzle <em class="flair">Officer</em></h2>
        <p class="lede">
          Irena was Chief Creative Officer at DuoFun Studios, driving creative
          direction on Chief Puzzle Officer — a real-time Match-3 PVP RPG card
          game. We brought AAA UX rigor to a dense indie battle screen.
        </p>
        <div class="featured-actions">
          <a href="/portfolio" class="btn btn-ghost">Portfolio gallery</a>
          <a href="/blog/evolution-of-a-battle-screen" class="text-link">Read the deep dive →</a>
        </div>
      </div>
      <div class="fan">
        {cpoShots.map((s) => (
          <figure class="shot">
            <img src={s.src} alt={s.alt} loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container about">
      <p class="eyebrow">03 — About</p>
      <h2 class="section-title">Executive strategy that gets its hands dirty and actually <em class="flair">builds</em>.</h2>
      <p class="lede">
        Most strategists hand you a deck and disappear. We write the market
        map and the GTM plan, then open Figma and build it with your team:
        the product, the brand, the site, the store. Twenty-five years of
        senior judgment, and none of it stays on a slide.
      </p>
    </div>
  </section>
</Base>

<script>
  // Typewriter: cycle the target customer after "experience design".
  const PHRASES = [
    "for games.",
    "for groundbreaking technologies.",
    "for entertainment.",
    "for consumers.",
    "for products.",
  ];
  const typed = document.querySelector<HTMLElement>(".hero .typed");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (typed && !reduce) {
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      let i = 0;
      let current = PHRASES[0];
      await sleep(1800);
      while (true) {
        // backspace only the part after "for "
        for (let n = current.length; n >= 4; n--) { typed.textContent = current.slice(0, n); await sleep(30); }
        await sleep(220);
        i = (i + 1) % PHRASES.length;
        const phrase = PHRASES[i];
        for (let n = 5; n <= phrase.length; n++) { typed.textContent = phrase.slice(0, n); await sleep(58); }
        current = phrase;
        await sleep(2000);
      }
    })();
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 12vw, 8.5rem);
    background:
      linear-gradient(to bottom, rgba(49, 170, 183, 0.06), transparent 55%),
      repeating-linear-gradient(to right, transparent 0 79px, rgba(255, 255, 255, 0.025) 79px 80px),
      repeating-linear-gradient(to bottom, transparent 0 79px, rgba(255, 255, 255, 0.02) 79px 80px);
  }
  /* Heritage bunny, watching from the wings */
  .hero-bunny {
    position: absolute;
    right: -2%;
    bottom: -16%;
    height: 110%;
    width: auto;
    opacity: 0.06;
    pointer-events: none;
    filter: drop-shadow(0 0 40px rgba(49, 170, 183, 0.25));
  }
  .hero .container { position: relative; }
  .hero h1 {
    font-size: clamp(2.3rem, 6.2vw, 4.6rem);  /* longest typed phrase fits one line ≥620px */
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.03;
    margin-bottom: 1.5rem;
  }
  .hero h1 .line { display: block; }
  .hero h1 .flair { color: var(--accent); padding-right: 0.08em; }
  /* phones: long phrases wrap — reserve two lines so typing doesn't shove the page */
  @media (max-width: 620px) { .hero h1 .flair { min-height: 2.06em; } }
  .cursor {
    display: inline-block;
    width: 0.1em;
    height: 0.78em;
    margin-left: 0.06em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

  .lede {
    max-width: 620px;
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    color: var(--text-muted);
  }
  .actions { display: flex; gap: 1rem; margin-top: 2.25rem; flex-wrap: wrap; }

  /* Ticker */
  .ticker {
    border-block: 1px solid var(--border);
    background: var(--bg-elev);
    overflow: hidden;
    padding-block: 0.8rem;
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: scroll 36s linear infinite;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .tick { padding-inline: 1.4rem; }
  .tick b { color: var(--accent); font-weight: 500; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }

  /* Stats */
  .stats { border-bottom: 1px solid var(--border); background: var(--bg-elev); }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .stat {
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-left: 1px solid var(--border);
  }
  .stat:last-child { border-right: 1px solid var(--border); }
  .value {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    color: var(--accent);
  }
  .label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  /* Client logo wall */
  .clients { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .logo-wall {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.25rem);
  }
  .logo-wall li { display: flex; align-items: center; }
  .logo-wall img {
    height: 40px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    /* source logos are black — render as white silhouettes on the dark UI */
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 0.55;
    transition: opacity 0.18s ease;
  }
  .logo-wall img:hover { opacity: 1; }
  /* vertical lockups get more height so they don't read undersized */
  .logo-wall img[src*="38studios"],
  .logo-wall img[src*="mythical"],
  .logo-wall img[src*="thirdkindgames"],
  .logo-wall img[src*="blizzard"] { height: 60px; }

  .section-alt { background: var(--bg-elev); border-block: 1px solid var(--border); }
  .section-title { font-size: clamp(1.7rem, 4vw, 2.5rem); margin-bottom: 2.5rem; }

  .grid {
    display: grid;
    grid-template-columns: 1fr;   /* mobile: single column */
    gap: 1.5rem;
  }
  @media (min-width: 600px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .card { padding: 1.75rem; }
  .card h3 { font-size: 1.25rem; }
  .card p { color: var(--text-muted); margin: 0; }
  .card .kind {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.7rem;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .about { max-width: 780px; }

  /* Services — editorial "pipeline" treatment: hairline top-rule + mono number */
  .svc {
    padding-top: 1.4rem;
    border-top: 1px solid var(--border-bright);
  }
  .svc-n {
    display: block;
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.22em;
    font-size: 0.82rem;
    margin-bottom: 1rem;
  }
  .svc h3 { font-size: clamp(1.3rem, 2.2vw, 1.65rem); margin: 0 0 0.8rem; transition: color 0.15s ease; }
  .svc p { color: var(--text-muted); margin: 0; }
  a.svc { display: block; color: inherit; }
  a.svc:hover h3 { color: var(--accent-bright); }
  .track { margin-bottom: 3rem; }
  .track-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.75rem;
    color: var(--hot);
    margin: 0 0 1.25rem;
  }

  /* Statement band — borrowed from the social campaign's poster voice */
  .statement-band {
    padding-block: clamp(4rem, 10vw, 7rem);
    text-align: center;
    border-block: 1px solid var(--border);
    background:
      radial-gradient(60% 120% at 50% 0%, rgba(49, 170, 183, 0.08), transparent 70%),
      var(--bg);
  }
  .statement-band .eyebrow { display: inline-block; }
  .statement-line {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.1rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text);
    max-width: 16ch;
    margin: 0 auto 1.1rem;
  }
  .statement-sub {
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    max-width: 42ch;
    margin: 0 auto;
  }

  /* Featured project spotlight */
  .featured {
    background:
      radial-gradient(60% 90% at 88% 50%, rgba(49, 170, 183, 0.08), transparent 70%),
      var(--bg-elev);
    border-block: 1px solid var(--border);
  }
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .featured-title { font-size: clamp(2rem, 5vw, 3.3rem); margin-bottom: 1.25rem; }
  .featured-copy .lede { color: var(--text-muted); max-width: 32rem; }
  .featured-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.9rem;
  }
  .text-link {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    color: var(--accent);
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.25rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .text-link:hover { color: var(--accent-bright); border-color: var(--accent-bright); }

  /* Fanned phone screens */
  .fan {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 380px;
  }
  .shot {
    margin: 0;
    width: clamp(116px, 13vw, 168px);
    /* no fixed aspect — each phone takes its screenshot's natural shape so
       nothing is cropped (the mask was cutting off the screenshots) */
    border-radius: 20px;
    overflow: hidden;
    background: #0b0b0d;
    padding: 5px;                 /* thin device bezel around the screen */
    border: 1px solid #2a2a2e;
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.55),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    transform: rotate(var(--rot)) translateY(var(--ty));
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease;
  }
  .shot:not(:first-child) { margin-left: -3.4rem; }
  .shot img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;          /* inner screen radius */
  }
  .shot:nth-child(1) { --rot: -9deg; --ty: 14px; z-index: 1; }
  .shot:nth-child(2) { --rot: -3deg; --ty: -8px; z-index: 2; }
  .shot:nth-child(3) { --rot: 3deg;  --ty: -8px; z-index: 3; }
  .shot:nth-child(4) { --rot: 9deg;  --ty: 14px; z-index: 4; }
  .shot:hover {
    transform: rotate(0deg) translateY(-16px) scale(1.05);
    box-shadow: 0 26px 54px rgba(0, 0, 0, 0.6), 0 0 0 1px var(--accent);
    z-index: 5;
  }

  @media (max-width: 860px) {
    .featured-grid { grid-template-columns: 1fr; }
    .fan { min-height: 0; margin-top: 1.5rem; }
    .shot { width: clamp(108px, 24vw, 150px); }
    .shot:not(:first-child) { margin-left: -2.6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot { transition: none; }
  }
</style>
