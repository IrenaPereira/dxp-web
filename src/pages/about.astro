---
import Base from "../layouts/Base.astro";

import { services as pillars } from "../data/services";

const extras = [
  {
    title: "Design Visualization",
    body: "We create the infographics and explainer visualizations that get a whole studio aligned — complex game loops and player progression, made legible for developers and stakeholders alike.",
  },
  {
    title: "Data-Driven Research",
    body: "We dig into player data to show you who your core audience really is, where your game is strong, and where it's losing players — turned into artifacts your team can act on.",
  },
  {
    title: "Workshops & Retrospectives",
    body: "Ideation workshops and structured retrospectives that surface the real issues — from what the team says in standup to what nobody has said out loud yet.",
  },
  {
    title: "Process Evaluation",
    body: "We interview stakeholders and whole teams to find where your production process loses time — then design a fix your team will actually use.",
  },
  {
    title: "Prioritization Exercises",
    body: "Working sessions that get teams agreeing on cost, value, and what to learn first when priorities compete — so the roadmap is a decision, not a debate.",
  },
  {
    title: "Service Blueprints",
    body: "One map of the whole player experience — back end, front end, and player decisions visualized together, so you change the experience deliberately instead of by accident.",
  },
  {
    title: "UX Curriculum",
    body: "A full curriculum on lean and agile UX practice, team structure, and minimizing product risk — taught as hands-on workshops by people who've shipped the work.",
  },
];
---

<Base
  title="About — Digital Experiments"
  description="Digital Experiments is a senior UX and growth studio for game studios and consumer brands — from Embedded UX & UI to GTM strategy, marketing, websites, and ecommerce."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>We're Digital Experiments.</h1>
      <p class="lede">
        A senior UX and growth studio for game studios and consumer brands,
        embedded in your team within days, not months. Twenty-five years of shipped
        UX on Valorant, World of Warcraft, and Monopoly Go, and of building and
        growing consumer products like REALTOR.com, Homebuilder.com, Hollywood
        Stock Exchange, and the Weider magazine sites. Product, market, launch:
        same team.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="statement">Your players decide in the <em class="flair flair-accent">first five minutes</em>.</p>
      <p class="phil">
        We put players at the core of everything we do. Start with the
        problem you're trying to solve, address that first — then layer in
        the delight that turns players into evangelists. No tutorial walls,
        no menu mazes, no inventory screen as the final boss.
      </p>
    </div>
  </section>

  <!-- Services: both tracks, from src/data/services.ts -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h2 class="section-title">Full capabilities</h2>
      <p class="phil" style="margin-bottom:2.5rem">Product &amp; UX on one side, growth &amp; GTM on the other. <a href="/services" class="inline-link">See how they fit together →</a></p>
      <div class="pillars">
        {pillars.map((p) => (
          <article class="pillar hud">
            <p class="kind">[{p.n}]</p>
            <h3>{p.title}</h3>
            <p class="blurb">{p.blurb}</p>
            <ul>
              {p.skills.map((s) => <li>{s}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Other capabilities -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Other capabilities</p>
      <h2 class="section-title">Beyond the <em class="flair">screen</em></h2>
      <div class="extras">
        {extras.map((e) => (
          <article class="extra hud">
            <h3>{e.title}</h3>
            <p>{e.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .statement {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
  }
  .phil { color: var(--text-muted); max-width: 680px; margin: 0; }
  .inline-link { color: var(--accent); border-bottom: 1px solid currentColor; }
  .inline-link:hover { color: var(--accent-bright); }

  .section-alt { background: var(--bg-elev); border-block: 1px solid var(--border); }
  .section-title { font-size: clamp(1.7rem, 4vw, 2.5rem); margin-bottom: 2.5rem; }

  .pillars {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 700px) {
    .pillars { grid-template-columns: 1fr; }
  }
  .pillar { padding: 1.75rem; }
  .pillar .kind {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.7rem;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .pillar h3 { font-size: 1.3rem; }
  .blurb { color: var(--text-muted); font-size: 0.95rem; }
  .pillar ul {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .pillar li {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text);
    padding-left: 1.1rem;
    position: relative;
  }
  .pillar li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .extras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .extra { padding: 1.5rem; }
  .extra h3 { font-size: 1.05rem; }
  .extra p { color: var(--text-muted); font-size: 0.92rem; margin: 0; }
</style>
