---
import Base from "../layouts/Base.astro";

const capabilities = [
  {
    title: "Experience Design",
    body: "Engaging customer experiences that carry end-to-end through your app, customer engagements, and marketing presence.",
  },
  {
    title: "Usability Workshops",
    body: "We teach human centricity at the core of everything we do, and customize workshops to transform your UX process around your team's real needs.",
  },
  {
    title: "Specialized Consultations",
    body: "UX in games and tech is at the core of what we do. We deliver active, high-fidelity UI/UX work — including extra hands when you're up against a deadline.",
  },
];
---

<Base
  title="About — Digital Experiments"
  description="Digital Experiments is a digital product and game agency. Strategy, design, and development with human-centered design at the core."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>Hey! We're Digital Experiments.</h1>
      <p class="lede">
        We're a digital product and game agency, based remotely — strategy,
        design, and development across games and other platforms.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <p class="statement">We revolutionise experiences.</p>
      <p>
        We put human-centricity at the core of everything we do. The goal isn't
        just a better screen — it's engaged, loyal customers who help evangelise
        you. We start with the problem you're trying to solve and address that
        first, then sprinkle in the delight that makes a product memorable.
      </p>

      <h2>What we do</h2>
      <div class="grid">
        {capabilities.map((c) => (
          <article class="card">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .about { max-width: 820px; }
  .about > p { color: var(--text-muted); max-width: 680px; }
  .statement {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    color: var(--text) !important;
    margin-bottom: 1rem;
  }
  .about h2 { font-size: 1.8rem; margin-top: 3rem; margin-bottom: 1.5rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .card h3 { font-size: 1.15rem; }
  .card p { color: var(--text-muted); margin: 0; }
</style>
