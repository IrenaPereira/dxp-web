---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Base
  title="Work Highlights — Digital Experiments"
  description="Case studies and lessons from our game UX work — World of Warcraft, Blankos, SciPlay, Project Copernicus and more."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1>Work Highlights</h1>
      <p class="lede">Exploring our past projects for learning.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              <h2>{post.data.title}</h2>
              <p>{post.data.excerpt}</p>
              <span class="read">Read →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .post-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .post-list a {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .post-list a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .post-list time {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    color: var(--accent-2);
  }
  .post-list h2 { font-size: 1.4rem; margin: 0.4rem 0 0.6rem; }
  .post-list p { color: var(--text-muted); margin: 0 0 0.75rem; }
  .read { color: var(--accent); font-weight: 600; font-family: var(--font-display); }
</style>
