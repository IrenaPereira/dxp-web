---
import Base from "../layouts/Base.astro";

const team = [
  {
    name: "Irena Pereira",
    role: "Founder & Design Director",
    bio: "Irena brings 25 years of building products and getting them to market. She built REALTOR.com®, Homebuilder.com, and Hollywood Stock Exchange, ran the websites for Weider Publications' magazine brands including Muscle & Fitness and Fit Pregnancy, and shipped UX on World of Warcraft and Monopoly Go. She pioneered A/B testing and data-driven design methods that are now industry standard. Today she partners with game studios and consumer brands on everything from product UX to GTM strategy, marketing, and ecommerce.",
  },
];
---

<Base
  title="The Team — Digital Experiments"
  description="Meet the team behind Digital Experiments — a senior, distributed crew of UX and growth specialists for games and consumer brands."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">The team</p>
      <h1>Senior people, scaled to <em class="flair">your project</em></h1>
      <p class="lede">
        A veteran core, plus a trusted bench of specialists we bring in per
        engagement — spanning art, design, production, engineering, and marketing.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="team-grid">
        {team.map((m) => (
          <article class="member hud">
            <h2>{m.name}</h2>
            <p class="role">{m.role}</p>
            <p class="bio">{m.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .team-grid { display: grid; gap: 1.5rem; max-width: 760px; }
  .member { padding: 2rem; }
  .member h2 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .role {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .bio { color: var(--text-muted); margin: 0; }
</style>
