---

<Base
  title="Portfolio — Digital Experiments"
  description="Roll the dice on 25+ years of product and game UX: World of Warcraft interfaces, MMO character create, card games, AI products, and the web that came before."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Portfolio</p>
      <h1>Artifacts from the <em class="flair">field</em></h1>
      <p class="lede">
        Two decades of game UX in one deck — {items.length} artifacts strong.
        Roll the dice and let the bones decide what you see. Doubles? You know
        the rule.
      </p>
    </div>
  </section>

  <!-- Dice table -->
  <section class="section" id="dice-mode">
    <div class="container">
      <div class="dice-table hud">
        <button id="roll" class="dice-btn" aria-label="Roll the dice to deal a new hand of work samples">
          <span class="die" id="die-a"><span class="face"></span></span>
          <span class="die" id="die-b"><span class="face"></span></span>
          <span class="roll-label">Roll</span>
        </button>
        <div class="roll-meta">
          <p class="status" id="dice-status" aria-live="polite">// shuffling the deck…</p>
          <p class="hint">
            Click to roll. The deck reshuffles and deals <em class="flair">the sum</em> —
            every hand is different.
          </p>
        </div>
      </div>

      <div class="masonry hand" id="hand" aria-live="polite"></div>

      <p class="archive-toggle">
        <button class="link-btn" id="show-archive">Prefer to browse? Open the full archive ▸</button>
      </p>
    </div>
  </section>

  <!-- Full archive (classic filterable gallery) -->
  <section class="section section-alt" id="archive" hidden>
    <div class="container">
      <div class="filter-bar" role="toolbar" aria-label="Filter portfolio">
        {CATS.map((c, i) => (
          <button class="chip" data-cat={c.id} aria-pressed={i === 0 ? "true" : "false"}>
            {c.label}
          </button>
        ))}
        <span class="count" id="count" aria-live="polite">// {items.length} artifacts</span>
      </div>

      <div class="masonry" id="masonry">
        {items.map((it) => (
          <figure class="piece" data-cat={it.cat}>
            <button
              class="piece-btn"
              data-full={it.src}
              data-title={it.title}
              data-tag={it.tag}
              data-caption={it.caption}
              aria-label={`View ${it.title}`}
            >
              <img src={it.src} alt={`${it.tag} — ${it.title}`} loading="lazy" />
              <figcaption>
                <span class="tag">{it.tag}</span>
                <span class="title">{it.title}</span>
              </figcaption>
            </button>
          </figure>
        ))}
      </div>

      <p class="archive-toggle">
        <button class="link-btn" id="show-dice">◂ Back to the dice</button>
      </p>
    </div>
  </section>

  <dialog id="lightbox">
    <button id="lb-close" aria-label="Close">✕</button>
    <img id="lb-img" src="" alt="" />
    <div class="lb-meta">
      <p class="tag" id="lb-tag"></p>
      <h2 id="lb-title"></h2>
      <p class="cap" id="lb-caption"></p>
    </div>
  </dialog>
</Base>

<script>
  /* ---------- Dice ---------- */
  // pip layouts on a 3×3 grid (cells 1–9, reading order)
  const PIPS: Record<number, number[]> = {
    1: [5], 2: [3, 7], 3: [3, 5, 7],
    4: [1, 3, 7, 9], 5: [1, 3, 5, 7, 9], 6: [1, 3, 4, 6, 7, 9],
  };
  const cell = (n: number) => `${Math.ceil(n / 3)} / ${((n - 1) % 3) + 1}`;
  const faceA = document.querySelector<HTMLElement>("#die-a .face")!;
  const faceB = document.querySelector<HTMLElement>("#die-b .face")!;
  const dice = [...document.querySelectorAll<HTMLElement>(".die")];
  const status = document.getElementById("dice-status")!;
  const hand = document.getElementById("hand")!;
  const rollBtn = document.getElementById("roll") as HTMLButtonElement;
  const deck = [...document.querySelectorAll<HTMLElement>("#masonry .piece")];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let rolling = false;
  const d6 = () => 1 + Math.floor(Math.random() * 6);

  function setFace(face: HTMLElement, v: number) {
    face.replaceChildren(
      ...PIPS[v].map((n) => {
        const pip = document.createElement("i");
        pip.className = "pip";
        pip.style.gridArea = cell(n);
        return pip;
      }),
    );
    (face.parentElement as HTMLElement).dataset.v = String(v);
  }

  function deal(n: number) {
    // shuffle indices, take n
    const order = deck.map((_, i) => i);
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }
    hand.innerHTML = "";
    order.slice(0, n).forEach((idx, i) => {
      const clone = deck[idx].cloneNode(true) as HTMLElement;
      clone.classList.add("dealt");
      clone.style.animationDelay = `${0.08 + i * 0.07}s`;
      const img = clone.querySelector("img");
      if (img) img.loading = "eager";
      hand.appendChild(clone);
    });
  }

  function roll() {
    if (rolling) return;
    rolling = true;
    const a = d6();
    const b = d6();
    const sum = a + b;

    if (reduceMotion) {
      setFace(faceA, a);
      setFace(faceB, b);
      finish(a, b, sum);
      return;
    }

    status.textContent = `// rolling…`;
    dice.forEach((d) => {
      d.classList.remove("rolling");
      void d.offsetWidth; // restart animation
      d.classList.add("rolling");
    });
    // tumble: flash random faces while the dice shake
    const tumble = setInterval(() => {
      setFace(faceA, d6());
      setFace(faceB, d6());
    }, 90);
    setTimeout(() => {
      clearInterval(tumble);
      setFace(faceA, a);
      setFace(faceB, b);
      dice.forEach((d) => d.classList.remove("rolling"));
      finish(a, b, sum);
    }, 760);
  }

  function finish(a: number, b: number, sum: number) {
    const doubles = a === b;
    status.textContent = doubles
      ? `// rolled ${a} + ${b} = ${sum} — doubles! house rules: roll again.`
      : `// rolled ${a} + ${b} — dealing ${sum} of ${deck.length}`;
    deal(sum);
    rolling = false;
  }

  // seed faces so the dice read as dice before the first roll
  setFace(faceA, 5);
  setFace(faceB, 2);

  rollBtn.addEventListener("click", () => roll());
  // opening hand
  setTimeout(() => roll(), 350);

  /* ---------- Mode toggle ---------- */
  const diceMode = document.getElementById("dice-mode")!;
  const archive = document.getElementById("archive")!;
  document.getElementById("show-archive")!.addEventListener("click", () => {
    diceMode.hidden = true;
    archive.hidden = false;
    window.scrollTo({ top: 0 });
  });
  document.getElementById("show-dice")!.addEventListener("click", () => {
    archive.hidden = true;
    diceMode.hidden = false;
    window.scrollTo({ top: 0 });
  });

  /* ---------- Archive filters ---------- */
  const chips = document.querySelectorAll(".chip");
  const count = document.getElementById("count")!;
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const cat = (chip as HTMLElement).dataset.cat;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      let n = 0;
      deck.forEach((p) => {
        const show = cat === "all" || p.dataset.cat === cat;
        p.style.display = show ? "" : "none";
        if (show) n++;
      });
      count.textContent = `// ${n} artifacts`;
    });
  });

  /* ---------- Lightbox (delegated — works for dealt clones too) ---------- */
  const lb = document.getElementById("lightbox") as HTMLDialogElement;
  const lbImg = document.getElementById("lb-img") as HTMLImageElement;
  const lbTag = document.getElementById("lb-tag")!;
  const lbTitle = document.getElementById("lb-title")!;
  const lbCaption = document.getElementById("lb-caption")!;

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".piece-btn");
    if (!btn) return;
    lbImg.src = btn.dataset.full!;
    lbImg.alt = `${btn.dataset.tag} — ${btn.dataset.title}`;
    lbTag.textContent = btn.dataset.tag!;
    lbTitle.textContent = btn.dataset.title!;
    lbCaption.textContent = btn.dataset.caption!;
    lb.showModal();
  });

  document.getElementById("lb-close")!.addEventListener("click", () => lb.close());
  lb.addEventListener("click", (e) => {
    if (e.target === lb) lb.close();
  });
</script>

<style>
  /* ---------- Dice table ---------- */
  .dice-table {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    margin-bottom: 2.25rem;
  }
  .dice-btn {
    all: unset;
    display: flex;
    align-items: center;
    gap: 1.4rem;
    cursor: pointer;
    padding: 0.5rem;
  }
  .dice-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .roll-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    border: 1px solid var(--border-bright);
    padding: 0.5rem 0.9rem;
    clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 9px 100%, 0 calc(100% - 9px));
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .dice-btn:hover .roll-label { color: var(--accent); border-color: var(--accent); }

  .die {
    position: relative;
    width: 68px;
    height: 68px;
    border-radius: 14px;
    background: linear-gradient(152deg, #2c2c31, #161619);
    border: 1px solid var(--border-bright);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      inset 0 -3px 8px rgba(0, 0, 0, 0.45),
      0 8px 16px rgba(0, 0, 0, 0.45);
    display: inline-block;
    will-change: transform;
  }
  .die .face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template: repeat(3, 1fr) / repeat(3, 1fr);
    padding: 11px;
    gap: 3px;
  }
  /* pips are created in JS (no scoped attr) → must be global */
  :global(#die-a .pip),
  :global(#die-b .pip) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    place-self: center;
    background: var(--accent);
    box-shadow: 0 0 8px rgba(49, 170, 183, 0.7);
  }
  /* second die rolls in heritage teal */
  :global(#die-b .pip) {
    background: var(--accent-2);
    box-shadow: 0 0 8px rgba(54, 226, 207, 0.7);
  }

  .die.rolling { animation: tumble 0.78s cubic-bezier(0.3, 0.7, 0.3, 1); }
  #die-b.rolling { animation-delay: 0.06s; }
  @keyframes tumble {
    0%   { transform: translateY(0) rotate(0) scale(1); }
    22%  { transform: translateY(-30px) rotate(-24deg) scale(1.06); }
    48%  { transform: translateY(3px) rotate(16deg) scale(0.97); }
    70%  { transform: translateY(-10px) rotate(-9deg) scale(1.01); }
    100% { transform: translateY(0) rotate(0) scale(1); }
  }

  .roll-meta { flex: 1; min-width: 260px; }
  .status {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin: 0 0 0.4rem;
  }
  .hint { color: var(--text-muted); margin: 0; font-size: 0.95rem; }
  .hint .flair { font-size: 1.1em; color: var(--text); }

  /* ---------- Dealt hand ---------- */
  .hand:empty { min-height: 40vh; }
  :global(.dealt) {
    animation: dealIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes dealIn {
    from { opacity: 0; transform: translateY(26px) rotate(0.6deg) scale(0.97); }
    to { opacity: 1; transform: none; }
  }

  .archive-toggle { margin-top: 2.5rem; text-align: center; }
  .link-btn {
    all: unset;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-bright);
    padding-bottom: 0.2rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .link-btn:hover { color: var(--accent); border-color: var(--accent); }
  .link-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .die.rolling { animation: none; }
    :global(.dealt) { animation: none; }
  }

  /* ---------- Filter bar ---------- */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.55rem 1rem;
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border);
    clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 9px 100%, 0 calc(100% - 9px));
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .chip:hover { color: var(--text); border-color: var(--border-bright); }
