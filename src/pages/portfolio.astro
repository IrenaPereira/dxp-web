---

<Base
  title="Portfolio — Digital Experiments"
  description="A filterable gallery of 20+ years of game UX: World of Warcraft interfaces, MMO character create, card games, AI products, and the web that came before."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Portfolio</p>
      <h1>Artifacts from the field</h1>
      <p class="lede">
        Interfaces, worlds, research, and product design from two decades of
        making games — and everything else — more playable.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filter-bar" role="toolbar" aria-label="Filter portfolio">
        {CATS.map((c, i) => (
          <button class="chip" data-cat={c.id} aria-pressed={i === 0 ? "true" : "false"}>
            {c.label}
          </button>
        ))}
        <span class="count" id="count" aria-live="polite">// {items.length} artifacts</span>
      </div>

      <div class="masonry" id="masonry">
        {items.map((it) => (
          <figure class="piece" data-cat={it.cat}>
            <button
              class="piece-btn"
              data-full={it.src}
              data-title={it.title}
              data-tag={it.tag}
              data-caption={it.caption}
              aria-label={`View ${it.title}`}
            >
              <img src={it.src} alt={`${it.tag} — ${it.title}`} loading="lazy" />
              <figcaption>
                <span class="tag">{it.tag}</span>
                <span class="title">{it.title}</span>
              </figcaption>
            </button>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <dialog id="lightbox">
    <button id="lb-close" aria-label="Close">✕</button>
    <img id="lb-img" src="" alt="" />
    <div class="lb-meta">
      <p class="tag" id="lb-tag"></p>
      <h2 id="lb-title"></h2>
      <p class="cap" id="lb-caption"></p>
    </div>
  </dialog>
</Base>

<script>
  const chips = document.querySelectorAll(".chip");
  const pieces = document.querySelectorAll<HTMLElement>(".piece");
  const count = document.getElementById("count")!;

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const cat = (chip as HTMLElement).dataset.cat;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      let n = 0;
      pieces.forEach((p) => {
        const show = cat === "all" || p.dataset.cat === cat;
        p.style.display = show ? "" : "none";
        if (show) n++;
      });
      count.textContent = `// ${n} artifacts`;
    });
  });

  const lb = document.getElementById("lightbox") as HTMLDialogElement;
  const lbImg = document.getElementById("lb-img") as HTMLImageElement;
  const lbTag = document.getElementById("lb-tag")!;
  const lbTitle = document.getElementById("lb-title")!;
  const lbCaption = document.getElementById("lb-caption")!;

  document.querySelectorAll<HTMLElement>(".piece-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      lbImg.src = btn.dataset.full!;
      lbImg.alt = `${btn.dataset.tag} — ${btn.dataset.title}`;
      lbTag.textContent = btn.dataset.tag!;
      lbTitle.textContent = btn.dataset.title!;
      lbCaption.textContent = btn.dataset.caption!;
      lb.showModal();
    });
  });

  document.getElementById("lb-close")!.addEventListener("click", () => lb.close());
  lb.addEventListener("click", (e) => {
    if (e.target === lb) lb.close();
  });
</script>

<style>
  /* Filter bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.55rem 1rem;
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border);
    clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 9px 100%, 0 calc(100% - 9px));
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .chip:hover { color: var(--text); border-color: var(--border-bright); }
  .chip[aria-pressed="true"] {
    background: var(--accent);
    color: #0a0c07;
    border-color: var(--accent);
    font-weight: 600;
  }
  .count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Masonry */
  .masonry { columns: 3 300px; column-gap: 1.25rem; }
  .piece {
    margin: 0 0 1.25rem;
    break-inside: avoid;
  }
  .piece-btn {
    all: unset;
    display: block;
    width: 100%;
    cursor: zoom-in;
    position: relative;
    border: 1px solid var(--border);
    background:
      linear-gradient(var(--accent), var(--accent)) top left / 14px 1px,
      linear-gradient(var(--accent), var(--accent)) top left / 1px 14px,
      linear-gradient(var(--accent), var(--accent)) bottom right / 14px 1px,
      linear-gradient(var(--accent), var(--accent)) bottom right / 1px 14px,
      var(--surface);
    background-repeat: no-repeat;
    overflow: hidden;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .piece-btn:hover { border-color: var(--border-bright); transform: translateY(-3px); }
  .piece-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .piece-btn img { width: 100%; display: block; }

  .piece-btn figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 1rem 0.8rem;
    background: linear-gradient(to top, rgba(8, 9, 12, 0.92), transparent);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    opacity: 0;
    translate: 0 8px;
    transition: opacity 0.18s ease, translate 0.18s ease;
  }
  .piece-btn:hover figcaption,
  .piece-btn:focus-visible figcaption { opacity: 1; translate: 0 0; }
  .piece-btn .tag {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  .piece-btn .title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.95rem;
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .piece-btn, .piece-btn figcaption { transition: none; }
  }

  /* Lightbox */
  #lightbox {
    background: var(--bg-elev);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius);
    padding: 0;
    max-width: min(1100px, 92vw);
    max-height: 92vh;
  }
  #lightbox::backdrop { background: rgba(5, 6, 8, 0.85); backdrop-filter: blur(4px); }
  #lb-img { max-width: 100%; max-height: 70vh; display: block; margin: 0 auto; }
  .lb-meta { padding: 1.1rem 1.5rem 1.4rem; }
  .lb-meta .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin: 0 0 0.25rem;
  }
  .lb-meta h2 { font-size: 1.2rem; margin: 0 0 0.3rem; color: var(--text); }
  .lb-meta .cap { color: var(--text-muted); margin: 0; font-size: 0.92rem; }
  #lb-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    background: rgba(8, 9, 12, 0.7);
    color: var(--text);
    border: 1px solid var(--border-bright);
    width: 36px;
    height: 36px;
    cursor: pointer;
    font-size: 1rem;
  }
  #lb-close:hover { color: var(--accent); border-color: var(--accent); }
</style>
