---
const links = [
  { href: "/work", label: "Work", n: "01" },
  { href: "/portfolio", label: "Portfolio", n: "02" },
  { href: "/blog", label: "Blog", n: "03" },
  { href: "/about", label: "About", n: "04" },
  { href: "/team", label: "Team", n: "05" },
];
---

<header class="site-header" data-open="false">
  <div class="container bar">
    <a href="/" class="wordmark" aria-label="Digital Experiments home">
      <img src="/brand/bunny-white.svg" alt="" aria-hidden="true" class="bunny" />
      <span class="mark">digital<b>experiments</b></span>
    </a>
    <nav id="primary-nav" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}><span class="n">{l.n}</span>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="mailto:sayhi@digitalexperiments.com" class="btn btn-hot say-hi">Say hi</a>
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="primary-nav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const toggle = header.querySelector<HTMLButtonElement>(".nav-toggle")!;
  const setOpen = (open: boolean) => {
    header.setAttribute("data-open", String(open));
    toggle.setAttribute("aria-expanded", String(open));
  };
  toggle.addEventListener("click", () =>
    setOpen(header.getAttribute("data-open") !== "true"),
  );
  header
    .querySelectorAll("#primary-nav a")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }
  .wordmark {
    display: flex;
    align-items: center;
  }
  .wordmark .mark {
    font-family: var(--font-serif);
    font-size: 1.34rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    color: var(--text);
  }
  .wordmark .mark b { font-weight: 700; }
  .wordmark .bunny {
    height: 26px;
    width: auto;
    margin-right: 0.6rem;
    opacity: 0.85;
    transition: opacity 0.15s ease, filter 0.15s ease;
  }
  .wordmark:hover .bunny {
    opacity: 1;
    filter: drop-shadow(0 0 6px rgba(49, 170, 183, 0.6));
  }
  nav { margin-inline: auto; }
  nav ul {
    display: flex;
    gap: 1.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: color 0.15s ease;
  }
  nav a .n {
    color: var(--accent);
    margin-right: 0.45em;
    font-size: 0.72rem;
  }
  nav a:hover { color: var(--text); }

  /* Hamburger — hidden on desktop */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--border-bright);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--text);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  [data-open="true"] .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  [data-open="true"] .nav-toggle span:nth-child(2) { opacity: 0; }
  [data-open="true"] .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 760px) {
    .nav-toggle { display: flex; flex: none; }
    .bar { gap: 0.6rem; }
    .wordmark .mark { font-size: 1.05rem; }
    .wordmark .bunny { height: 22px; margin-right: 0.45rem; }
    .say-hi { margin-left: auto; padding: 0.55rem 0.85rem; font-size: 0.74rem; }
    nav {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      margin: 0;
      background: var(--bg-elev);
      border-bottom: 1px solid var(--border);
      overflow: hidden;
      max-height: 0;
      transition: max-height 0.25s ease;
    }
    [data-open="true"] nav { max-height: 70vh; }
    nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.25rem var(--gutter) 1rem;
    }
    nav li { border-top: 1px solid var(--border); }
    nav a { display: block; padding: 1rem 0; font-size: 0.95rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    nav, .nav-toggle span { transition: none; }
  }
</style>
