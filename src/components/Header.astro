---
const links = [
  { href: "/work", label: "Work", n: "01" },
  { href: "/portfolio", label: "Portfolio", n: "02" },
  { href: "/blog", label: "Blog", n: "03" },
  { href: "/about", label: "About", n: "04" },
  { href: "/team", label: "Team", n: "05" },
];
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="wordmark" aria-label="Digital Experiments home">
      <img src="/brand/bunny-white.svg" alt="" aria-hidden="true" class="bunny" />
      <span class="mark"><b>digital</b>experiments</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}><span class="n">{l.n}</span>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="mailto:sayhi@digitalexperiments.com" class="btn btn-hot">Say hi</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }
  .wordmark {
    display: flex;
    align-items: center;
  }
  .wordmark .mark {
    font-family: var(--font-serif);
    font-size: 1.34rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    color: var(--text);
  }
  .wordmark .mark b { font-weight: 700; }
  .wordmark .bunny {
    height: 26px;
    width: auto;
    margin-right: 0.6rem;
    opacity: 0.85;
    transition: opacity 0.15s ease, filter 0.15s ease;
  }
  .wordmark:hover .bunny {
    opacity: 1;
    filter: drop-shadow(0 0 6px rgba(49, 170, 183, 0.6));
  }
  nav { margin-inline: auto; }
  nav ul {
    display: flex;
    gap: 1.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: color 0.15s ease;
  }
  nav a .n {
    color: var(--accent);
    margin-right: 0.45em;
    font-size: 0.72rem;
  }
  nav a:hover { color: var(--text); }

  @media (max-width: 760px) {
    nav { display: none; }
    .bar { justify-content: space-between; }
  }
</style>
