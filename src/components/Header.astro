---
const links = [
  { href: "/work", label: "Work", n: "01" },
  { href: "/portfolio", label: "Portfolio", n: "02" },
  { href: "/blog", label: "Blog", n: "03" },
  { href: "/about", label: "About", n: "04" },
  { href: "/team", label: "Team", n: "05" },
];
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="wordmark" aria-label="Digital Experiments home">
      digital<span>experiments</span><i class="cursor" aria-hidden="true"></i>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}><span class="n">{l.n}</span>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="mailto:sayhi@digitalexperiments.com" class="btn">Say hi</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
  }
  .wordmark span { color: var(--accent); }
  .cursor {
    width: 8px;
    height: 1.05em;
    margin-left: 4px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

  nav { margin-inline: auto; }
  nav ul {
    display: flex;
    gap: 1.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: color 0.15s ease;
  }
  nav a .n {
    color: var(--accent);
    margin-right: 0.45em;
    font-size: 0.72rem;
  }
  nav a:hover { color: var(--text); }

  @media (max-width: 760px) {
    nav { display: none; }
    .bar { justify-content: space-between; }
  }
</style>
