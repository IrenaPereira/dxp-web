---
const year = new Date().getFullYear();
const needs = ["UX Workshop", "UI/UX Audit", "Embedded UX & UI team", "UX Strategy", "Not sure yet"];

// Web3Forms access key — get a free one at https://web3forms.com (enter
// sayhi@digitalexperiments.com; the key is public/client-side by design).
// Overridable at build time via PUBLIC_WEB3FORMS_KEY; falls back to the key below.
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "fba572ba-28d5-431e-bf46-058e16129056";
---

<footer id="contact" class="site-footer">
  <div class="container contact-block">
    <!-- left: copy + contact details -->
    <div class="contact-copy">
      <p class="eyebrow">Say hi</p>
      <h2>Let's make your game <em class="flair">better</em>.</h2>
      <p class="contact-lede">
        Tell us about the problem you're solving. We'll come back with how we'd
        approach it — workshop, audit, or embedded team.
      </p>
      <hr class="rule" />
      <ul class="contact-details">
        <li><a href="mailto:sayhi@digitalexperiments.com" class="email">sayhi@digitalexperiments.com</a></li>
        <li><a href="tel:+19782939231">978-293-9231</a></li>
        <li><a href="https://www.linkedin.com/company/digitalexperiments/" target="_blank" rel="noopener">LinkedIn ↗</a></li>
        <li class="addr">Cumberland · Rhode Island 02864 · USA</li>
      </ul>
    </div>

    <!-- right: contact form (submits to Web3Forms — static-host friendly) -->
    <form id="contact-form" class="contact-form hud" action="https://api.web3forms.com/submit" method="POST" novalidate>
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="New inquiry — digitalexperiments.com" />
      <input type="hidden" name="from_name" value="Digital Experiments website" />
      <div class="row">
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="cf-studio">Studio</label>
          <input id="cf-studio" name="studio" type="text" placeholder="Studio name" autocomplete="organization" />
        </div>
      </div>
      <div class="field">
        <label for="cf-email">Work email</label>
        <input id="cf-email" name="email" type="email" placeholder="you@studio.com" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="cf-need">What do you need?</label>
        <div class="select-wrap">
          <select id="cf-need" name="need" required>
            <option value="" selected disabled>Choose one…</option>
            {needs.map((n) => <option value={n}>{n}</option>)}
          </select>
        </div>
      </div>
      <div class="field">
        <label for="cf-message">Tell us about your game</label>
        <textarea id="cf-message" name="message" rows="4" placeholder="An open-world MMO that needs a fast-travel system…" required></textarea>
      </div>

      <!-- honeypot (Web3Forms rejects the submission if botcheck is set) -->
      <div class="hp" aria-hidden="true">
        <label for="cf-company-url">Company URL</label>
        <input id="cf-company-url" name="company_url" type="text" tabindex="-1" autocomplete="off" />
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="btn" id="cf-submit">Send message</button>
      <p class="form-msg" id="cf-msg" role="status" aria-live="polite" hidden></p>
    </form>
  </div>

  <div class="container foot-bottom">
    <nav class="foot-nav" aria-label="Footer">
      <a href="/work">Work</a>
      <a href="/portfolio">Portfolio</a>
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/team">Team</a>
    </nav>
    <p class="copyright">
      <span class="wordmark">digital<b>experiments</b></span>
      <span class="legal">© {year} — better design, better games.</span>
      <span class="waves">make waves</span>
    </p>
  </div>
</footer>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  if (form) {
    const msg = document.getElementById("cf-msg")!;
    const btn = document.getElementById("cf-submit") as HTMLButtonElement;
    const show = (text: string, kind: "ok" | "err") => {
      msg.textContent = text;
      msg.dataset.kind = kind;
      msg.hidden = false;
    };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = "Sending…";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => ({ success: res.ok }));
        if (res.ok && data.success) {
          form.reset();
          show("Got it — thanks! We'll be in touch within a day or two.", "ok");
          btn.hidden = true;
        } else {
          show(data.message || "Something went wrong. Please email sayhi@digitalexperiments.com.", "err");
          btn.disabled = false;
          btn.textContent = label;
        }
      } catch {
        show("Couldn't reach the server. Please email sayhi@digitalexperiments.com.", "err");
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background:
      linear-gradient(to top, rgba(49, 170, 183, 0.05), transparent 55%),
      var(--bg-elev);
    padding-block: clamp(3.5rem, 8vw, 6rem) 2.5rem;
  }

  .contact-block {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* left column */
  .contact-copy h2 {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    margin: 0 0 1.25rem;
    line-height: 1.05;
  }
  .contact-lede { color: var(--text-muted); max-width: 30rem; margin: 0; }
  .rule { border: 0; border-top: 1px solid var(--border); margin: 2rem 0 1.75rem; }
  .contact-details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }
  .contact-details a { color: var(--text-muted); transition: color 0.15s ease; }
  .contact-details a:hover { color: var(--accent); }
  .contact-details .email { color: var(--accent); }
  .contact-details .addr { color: var(--text-muted); }

  /* right column — form */
  .contact-form { padding: clamp(1.5rem, 3vw, 2.25rem); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  .field { margin-bottom: 1.2rem; }
  .field label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 0.45rem;
  }
  .field input,
  .field textarea,
  .field select {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.98rem;
    padding: 0.7rem 0.85rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field textarea { resize: vertical; }
  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(49, 170, 183, 0.22);
  }
  .field input::placeholder, .field textarea::placeholder { color: var(--text-muted); opacity: 0.7; }

  /* custom select arrow */
  .select-wrap { position: relative; }
  .select-wrap select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 2.2rem;
    cursor: pointer;
  }
  .select-wrap::after {
    content: "";
    position: absolute;
    right: 0.95rem;
    top: 50%;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--text-muted);
    border-bottom: 2px solid var(--text-muted);
    transform: translateY(-65%) rotate(45deg);
    pointer-events: none;
  }
  .contact-form select option { background: var(--bg-elev); color: var(--text); }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  #cf-submit { margin-top: 0.4rem; }
  #cf-submit[hidden] { display: none; } /* id+attr beats .btn's display:inline-block */
  .form-msg {
    margin: 1.1rem 0 0;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    font-size: 0.92rem;
  }
  .form-msg[data-kind="ok"] {
    color: var(--text);
    border: 1px solid var(--accent);
    background: linear-gradient(to right, rgba(49, 170, 183, 0.12), transparent);
  }
  .form-msg[data-kind="err"] {
    color: var(--text);
    border: 1px solid var(--danger);
    background: linear-gradient(to right, rgba(196, 85, 77, 0.14), transparent);
  }

  /* bottom meta row */
  .foot-bottom {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .foot-nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .foot-nav a {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }
  .foot-nav a:hover { color: var(--accent); }
  .copyright {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }
  .copyright .wordmark { font-family: var(--font-serif); font-size: 1.05rem; color: var(--text); }
  .copyright .wordmark b { font-weight: 700; }
  .waves {
    font-family: var(--font-script);
    font-size: 1.15em;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .contact-block { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  @media (max-width: 480px) {
    .row { grid-template-columns: 1fr; }
  }
</style>
