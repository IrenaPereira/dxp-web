---
const year = new Date().getFullYear();
---

<footer id="contact" class="site-footer">
  <div class="container">
    <div class="cta">
      <p class="eyebrow">Let's work together</p>
      <h2>Got a game that deserves better UX?</h2>
      <a href="mailto:sayhi@digitalexperiments.com" class="btn">sayhi@digitalexperiments.com</a>
    </div>

    <div class="meta">
      <div class="wordmark">digital<span>experiments</span></div>
      <address>
        Cumberland, Rhode Island 02864, USA<br />
        <a href="tel:+19782939231">978-293-9231</a> ·
        <a href="mailto:sayhi@digitalexperiments.com">sayhi@digitalexperiments.com</a>
      </address>
      <p class="copyright">© {year} Digital Experiments. better design, better games.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
    padding-block: clamp(3.5rem, 8vw, 6rem) 2.5rem;
  }
  .cta { text-align: center; max-width: 620px; margin: 0 auto 4rem; }
  .cta h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); margin-bottom: 1.5rem; }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
  }
  .wordmark span { color: var(--accent); }
  address { font-style: normal; }
  .meta a:hover { color: var(--text); }
  .copyright { margin: 0; }
</style>
