---
const year = new Date().getFullYear();
---

<footer id="contact" class="site-footer">
  <div class="container">
    <div class="cta">
      <p class="eyebrow">Initiate contact</p>
      <h2>Got a game that<br />deserves better UX?</h2>
      <a href="mailto:sayhi@digitalexperiments.com" class="btn">sayhi@digitalexperiments.com</a>
    </div>

    <div class="meta">
      <div class="wordmark">digital<span>experiments</span></div>
      <address>
        Cumberland, Rhode Island 02864, USA<br />
        <a href="tel:+19782939231">978-293-9231</a> ·
        <a href="mailto:sayhi@digitalexperiments.com">sayhi@digitalexperiments.com</a>
      </address>
      <p class="copyright">© {year} Digital Experiments — better design, better games.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background:
      linear-gradient(to top, rgba(200, 243, 29, 0.04), transparent 50%),
      var(--bg-elev);
    padding-block: clamp(3.5rem, 8vw, 6rem) 2.5rem;
  }
  .cta { text-align: center; max-width: 680px; margin: 0 auto 4rem; }
  .cta .eyebrow { margin-bottom: 1.25rem; }
  .cta h2 { font-size: clamp(1.7rem, 4.5vw, 2.8rem); margin-bottom: 1.75rem; }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    color: var(--text);
  }
  .wordmark span { color: var(--accent); }
  address { font-style: normal; }
  .meta a:hover { color: var(--text); }
  .copyright { margin: 0; }
</style>
